# --- Database ---
# Vercel Postgres / Neon connection string
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Platform-level WhatsApp (shared by every vendor) ---
# The platform operates ONE Meta App; every vendor's WhatsApp number gets
# added under this same app (like a BSP — Twilio/360dialog/Wati work the
# same way). Per-vendor phone_number_id + access token are NOT set here —
# each vendor configures their own from their admin dashboard's Settings
# page, since those differ per vendor.
#
# From Meta App > App Settings > Basic > App Secret
WHATSAPP_APP_SECRET=
# Any string you choose — must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string

# --- Session signing ---
# Random string used to sign vendor admin-login session cookies. Generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Misc ---
# Public URL of this deployment, used for Paystack callback URLs
SITE_URL=https://your-app.vercel.app

# --- Local demo/dev seed only ---
# Used by `npm run db:seed` to set the demo vendor's admin password and
# vendor-notification number. Not read anywhere else.
DEMO_ADMIN_PASSWORD=demo1234
VENDOR_PHONE_NUMBER=
