# --- Database ---
# Vercel Postgres / Neon connection string
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Platform-level WhatsApp (shared by every vendor) ---
# The platform operates ONE Meta App; every vendor's WhatsApp number gets
# added under this same app (like a BSP — Twilio/360dialog/Wati work the
# same way). Per-vendor phone_number_id + access token are NOT set here —
# each vendor's own number is linked by the operator command (see README)
# and stored on their vendor row.
#
# From Meta App > App Settings > Basic > App Secret
WHATSAPP_APP_SECRET=
# Any string you choose — must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string

# --- Platform's own WhatsApp number ---
# A separate phone number (also added to the same Meta App above) that
# handles new-vendor registration and the operator's "link"/"vendors"
# commands. Get these the same way as any vendor number: WhatsApp -> API
# Setup in the Meta App.
PLATFORM_PHONE_NUMBER_ID=
PLATFORM_WHATSAPP_TOKEN=

# The operator's (your) own WhatsApp number, digits only, no +, e.g.
# 2348012345678. Messages to the platform number FROM this number are
# treated as operator commands instead of vendor registration.
OPERATOR_PHONE_NUMBER=

# --- Misc ---
# Public URL of this deployment (not required for any WhatsApp flow, but
# used if you ever add Paystack's callback_url redirect)
SITE_URL=https://your-app.vercel.app

# --- Local demo/dev seed only ---
# Used by `npm run db:seed` as the demo vendor's adminPhone (their WhatsApp
# "admin identity" — see README). Not read anywhere else.
VENDOR_PHONE_NUMBER=2348000000001
